<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- API 31+ copy of AppTheme (a style override replaces the whole style,
         so the base items are repeated) adding system-splash styling: the
         default splash renders the adaptive icon on its WHITE background
         layer, which floats oddly on our black window. Instead show just the
         icon's foreground tiles on a black splash. -->
    <style name="AppTheme" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="colorPrimary">@color/darkGrey</item>
        <item name="colorPrimaryDark">@color/black</item>
        <item name="colorAccent">@color/darkerRubyRed</item>
        <item name="android:textColorPrimary">@android:color/white</item>
        <item name="android:colorBackground">@android:color/black</item>
        <item name="android:navigationBarColor">@android:color/black</item>
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="27">false</item>

        <item name="android:windowSplashScreenBackground">@android:color/black</item>
        <item name="android:windowSplashScreenAnimatedIcon">@mipmap/ic_launcher_foreground</item>
    </style>

</resources>
