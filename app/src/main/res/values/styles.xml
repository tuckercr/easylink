<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- Base theme for the app window — Compose handles all UI theming internally -->
    <style name="AppTheme" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="colorPrimary">@color/darkGrey</item>
        <item name="colorPrimaryDark">@color/black</item>
        <item name="colorAccent">@color/darkerRubyRed</item>
        <item name="android:textColorPrimary">@android:color/white</item>
        <item name="android:colorBackground">@android:color/black</item>
        <item name="android:navigationBarColor">@android:color/black</item>
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="27">false</item>
    </style>

    <!-- Always-dark alert dialogs. The activity theme is DayNight, so on a
         light-mode device the default dialog window turns white while AppTheme
         forces textColorPrimary to white — a blank white box. The app is
         always dark; its dialogs must be too. -->
    <style name="AppTheme.AlertDialog" parent="Theme.AppCompat.Dialog.Alert" />

    <!-- Alias used in manifest — same as AppTheme since NoActionBar is already in parent -->
    <style name="AppTheme.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
    </style>

</resources>
