<?xml version="1.0" encoding="utf-8"?>
<!--
    Auto Backup rules for API 23–30 (android:fullBackupContent).
    API 31+ uses data_extraction_rules.xml instead.

    Domains:
      database  →  /data/data/<pkg>/databases/
      file      →  /data/data/<pkg>/files/

    DataStore files live under files/datastore/.
    Room (TRUNCATE mode) writes a single easylink.db with no WAL side-cars.
-->
<full-backup-content>
    <!-- Room database -->
    <include
        domain="database"
        path="easylink.db" />

    <!-- DataStore preference stores -->
    <include
        domain="file"
        path="datastore/home_prefs.preferences_pb" />
    <!-- onboarding_prefs is deliberately NOT backed up: restoring the
         "onboarding complete" flag to a fresh install skips the permission
         wizard, but permissions are never restored with it - leaving the
         app with no permissions and no way to ask. Onboarding must re-run
         on every fresh install. -->
    <include
        domain="file"
        path="datastore/fall_prefs.preferences_pb" />
    <!-- weather_prefs holds only the last-known location; intentionally included
         so the weather widget works immediately after restore. -->
    <include
        domain="file"
        path="datastore/weather_prefs.preferences_pb" />
</full-backup-content>
