<?xml version="1.0" encoding="utf-8"?>
<!--
    Data extraction rules for API 31+ (android:dataExtractionRules).
    Older devices use backup_descriptor.xml (android:fullBackupContent).

    cloud-backup   → Google Drive Auto Backup
    device-transfer → device-to-device transfers (e.g. phone setup wizard)
-->
<data-extraction-rules>

    <cloud-backup>
        <!-- Room database (single file; WAL disabled via JournalMode.TRUNCATE) -->
        <include domain="database" path="easylink.db" />

        <!-- DataStore preference stores -->
        <!-- onboarding_prefs is deliberately excluded: permissions never
             restore with a backup, so restoring the "onboarding complete"
             flag would skip the wizard that asks for them. -->
        <include domain="file" path="datastore/home_prefs.preferences_pb" />
        <include domain="file" path="datastore/fall_prefs.preferences_pb" />
        <include domain="file" path="datastore/weather_prefs.preferences_pb" />
    </cloud-backup>

    <device-transfer>
        <!-- Include everything for a full transfer to a new phone -->
        <include domain="database" path="easylink.db" />
        <!-- onboarding_prefs excluded here too: a new device has no granted
             permissions either. -->
        <include domain="file" path="datastore/home_prefs.preferences_pb" />
        <include domain="file" path="datastore/fall_prefs.preferences_pb" />
        <include domain="file" path="datastore/weather_prefs.preferences_pb" />
    </device-transfer>

</data-extraction-rules>
